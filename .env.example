# Isi di Vercel → Project Settings → Environment Variables
# Jangan pernah memasukkan SUPABASE_SERVICE_ROLE_KEY ke Vercel/frontend.

BACKEND=supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=anon-key-dari-project-settings-api
SUPABASE_FUNCTION_URL=https://xxxx.supabase.co/functions/v1/cek-api
